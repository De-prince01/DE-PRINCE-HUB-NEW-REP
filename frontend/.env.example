# DE-PRINCE DIGITAL HUB - Frontend environment
# Copy to frontend/.env.local for local dev (or set on the CI/CD host).

# Full public site origin (no trailing slash). Used for sitemap/robots/metadata.
NEXT_PUBLIC_SITE_URL=https://deprince.example

# Backend API base URL the browser calls.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Brand name override.
NEXT_PUBLIC_APP_NAME=De-Prince Digital Hub