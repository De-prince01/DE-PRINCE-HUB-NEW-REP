# ============================================================
# DE-PRINCE DIGITAL HUB — Environment Variables
# ============================================================

# ---- General ----
APP_NAME="De-Prince Digital Hub"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-64-char-string
# List fields use JSON-array format (comma-separated also works)
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# ---- Database ----
# PostgreSQL for production / Docker
POSTGRES_USER=deprince
POSTGRES_PASSWORD=deprince_secret_2026
POSTGRES_DB=deprince_db
DATABASE_URL=postgresql+asyncpg://deprince:deprince_secret_2026@postgres:5432/deprince_db
DATABASE_URL_SYNC=postgresql://deprince:deprince_secret_2026@postgres:5432/deprince_db

# Local dev without Docker (SQLite fallback) - uncomment and comment the Postgres lines:
# DATABASE_URL=sqlite+aiosqlite:///./data/deprince.db
# DATABASE_URL_SYNC=sqlite:///./data/deprince.db

# ---- Backend ----
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---- JWT Auth ----
JWT_SECRET_KEY=change-this-jwt-secret-to-random-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- File Upload ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=["pdf","docx","doc","pptx","xlsx","jpg","jpeg","png","zip"]

# ---- Payments ----
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxx

# ---- Email ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@deprince.com

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=De-Prince Digital Hub
NEXT_PUBLIC_APP_URL=http://localhost:3000
