# DE-PRINCE DIGITAL HUB — Backend environment (example)
# Copy to backend/.env and adjust.

APP_NAME="De-Prince Digital Hub"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-64-char-string
# List fields use JSON-array format (comma-separated also works)
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Local dev (SQLite) — no Docker required
DATABASE_URL=sqlite+aiosqlite:///./data/deprince.db
DATABASE_URL_SYNC=sqlite:///./data/deprince.db

# PostgreSQL for production — override DATABASE_URL lines:
# DATABASE_URL=postgresql+asyncpg://deprince:deprince_secret_2026@postgres:5432/deprince_db
# DATABASE_URL_SYNC=postgresql://deprince:deprince_secret_2026@postgres:5432/deprince_db

JWT_SECRET_KEY=change-this-jwt-secret-to-random-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=["pdf","docx","doc","pptx","xlsx","jpg","jpeg","png","zip"]

# Payment provider keys — leave blank to use the mock gateway in development
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@deprince.com
