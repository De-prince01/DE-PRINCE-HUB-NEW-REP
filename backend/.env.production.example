# DE-PRINCE DIGITAL HUB - PRODUCTION ENV TEMPLATE
# Copy to backend/.env on the production server and fill in real values.
# NEVER commit real secrets.
APP_NAME="De-Prince Digital Hub"
APP_ENV=production
DEBUG=false
SECRET_KEY=REPLACE_WITH_A_RANDOM_64_TO_86_CHAR_TOKEN
# Comma-separated or JSON list of your public FQDNs:
ALLOWED_HOSTS=["api.deprince.com","deprince.com"]

# PostgreSQL (async) + sync (for migration/management scripts):
DATABASE_URL=postgresql+asyncpg://deprince:PASSWORD@db-host:5432/deprince
DATABASE_URL_SYNC=postgresql+psycopg2://deprince:PASSWORD@db-host:5432/deprince

JWT_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_64_TO_86_CHAR_TOKEN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Your deployed frontend origin(s):
CORS_ORIGINS=["https://deprince.com"]

UPLOAD_DIR=/var/lib/deprince/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=["pdf","docx","doc","pptx","xlsx","jpg","jpeg","png","zip"]

# Real payment keys - when blank the MOCK provider is used (no real charges!):
PAYSTACK_SECRET_KEY=pk_live_xxxxxxxx
PAYSTACK_PUBLIC_KEY=xx_xxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxx

# Identity verification:
IDENTITY_PROVIDER=smile_identity
SME_NIN_SECRET=
SME_BVN_SECRET=

# SMTP for transactional email:
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@deprince.com